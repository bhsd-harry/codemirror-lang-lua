{
  "name": "@codincod/codemirror-lang-lua",
  "version": "0.1.0",
  "description": "Lua language support for CodeMirror 6, built on a Lezer grammar",
  "keywords": [
    "codemirror",
    "codemirror6",
    "lezer",
    "lua",
    "luau",
    "syntax",
    "highlighting",
    "parser",
    "editor"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src/lua.grammar",
    "src/tokens.js"
  ],
  "scripts": {
    "build:parser": "mkdir -p dist && lezer-generator src/lua.grammar -o dist/parser.js",
    "build": "npm run build:parser && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"test/*.test.ts\"",
    "corpus": "npm run build && node test/corpus.ts",
    "prepublishOnly": "npm run test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@lezer/common": "^1.0.0",
    "@lezer/highlight": "^1.0.0",
    "@lezer/lr": "^1.0.0"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.1",
    "@lezer/generator": "^1.7.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/reeven/codemirror-lang-lua.git"
  }
}
