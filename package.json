{
  "name": "@codincod/codemirror-lang-lua",
  "version": "0.3.0",
  "description": "Lua language support for the CodeMirror code editor",
  "keywords": [
    "editor",
    "code"
  ],
  "author": "CodinCod <hello@codincod.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && lezer-generator src/lua.grammar -o src/parser.js && cm-buildhelper src/lua.ts",
    "build-debug": "lezer-generator src/lua.grammar --names -o src/parser.js && cm-buildhelper src/lua.ts",
    "prepare": "npm run build",
    "test": "npm run build && node --test \"test/*.test.ts\"",
    "measure": "npm run build && node ../lezer-survey/src/cli.ts measure --group top",
    "fuzz": "npm run build && node ../lezer-survey/src/cli.ts fuzz",
    "gaps": "npm run build && node ../lezer-survey/src/cli.ts gaps --group top"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@lezer/common": "^1.0.0",
    "@lezer/highlight": "^1.0.0",
    "@lezer/lr": "^1.0.0"
  },
  "devDependencies": {
    "@codemirror/buildhelper": "^1.0.2",
    "@codemirror/state": "^6.7.1",
    "@lezer/generator": "^1.7.0",
    "typescript": "^5.6.0"
  },
  "homepage": "https://codincod.com/",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/reeven/codemirror-lang-lua"
  }
}
