{
	"name": "@bhsd/codemirror-lang-lua",
	"version": "0.4.0",
	"description": "Lua language support for the CodeMirror code editor",
	"keywords": [
		"codemirror",
		"lezer",
		"lua"
	],
	"contributors": [
		"CodinCod <hello@codincod.com>",
		"Bhsd"
	],
	"license": "MIT",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && lezer-generator src/lua.grammar -o src/parser.js && npm run build:core",
		"build:core": "tsc && cp src/parser.* dist/ && eslint --no-config-lookup -c eslint.dist.js dist/*.js",
		"prepublishOnly": "npm run build",
		"lint:ts": "tsc --noEmit && tsc -p test/tsconfig.json --noEmit && eslint --cache .",
		"lint:md": "myMarkdownlint",
		"lint": "npm run lint:ts && npm run lint:md",
		"test": "rm -rf test/dist/; tsc -p test/tsconfig.json && testUtil test/dist/*.test.js",
		"test:real": "node test/dist/real.js"
	},
	"peerDependencies": {
		"@codemirror/autocomplete": "^6.0.0",
		"@codemirror/language": "^6.0.0"
	},
	"devDependencies": {
		"@bhsd/code-standard": "^5.0.0",
		"@bhsd/nodejs": "^1.2.1",
		"@bhsd/test-util": "^3.3.0",
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@lezer/generator": "^1.8.1",
		"eslint": "^10.13.0",
		"typescript": "^7.0.2"
	},
	"homepage": "https://github.com/bhsd-harry/codemirror-lang-lua#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/codemirror-lang-lua/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bhsd-harry/codemirror-lang-lua.git"
	}
}
